{
  "name": "warehouse-finance-tracker-be",
  "version": "1.0.0",
  "description": "Warehouse & Finance Management API",
  "author": "",
  "license": "MIT",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/",
    "db:help": "bun run scripts/migrate.ts --help",
    "db:migrate": "bun run scripts/migrate.ts",
    "db:migrate:select": "bun run scripts/migrate.ts --run",
    "db:rollback": "bun run scripts/migrate.ts --rollback",
    "db:status": "bun run scripts/migrate.ts --status",
    "db:reset": "bun run scripts/reset-db.ts",
    "db:seed": "bun run scripts/seed.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.6",
    "hono": "^4.12.2",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@types/bun": "^1.3.9",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
